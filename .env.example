# Copy to .env. Node 24+ required. Never commit the real file.
PORT=3001
PUBLIC_ORIGIN=http://localhost:3001
DATABASE_PATH=./data/buildfest.sqlite
# Set a unique password of at least 16 characters to enable the dashboard.
ADMIN_PASSWORD=
# Production: NODE_ENV=production, HTTPS reverse proxy, PUBLIC_ORIGIN=https://your-domain
# Payments also require confirmed feeBasis, rulesAcceptedText and registrationStatus=open.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Disabled until storage and participant-data handling are ready.
# Google Sheets is not connected; enabling this currently uses SQLite.
ENABLE_FORM_SUBMISSIONS=false
ALLOW_THIRD_PARTY_CHECKOUT=false

# Registration-page entries stored in Google Sheets (separate from paid checkout).
# Deploy integrations/google-sheets/Code.gs first; never use VITE_ for these values.
ENABLE_REGISTRATION_SUBMISSIONS=false
REGISTRATION_SHEETS_URL=
REGISTRATION_SHEETS_SECRET=
